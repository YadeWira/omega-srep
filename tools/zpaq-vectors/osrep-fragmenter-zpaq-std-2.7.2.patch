+    UINT64_C(0x6F9D23A508E125E1), UINT64_C(0xF8341333B5F8B8CB),
+    UINT64_C(0x871692E6D5DBAC85), UINT64_C(0x450CAC6640741EAB),
+    UINT64_C(0x38C82A30E5C5AA5F), UINT64_C(0xFBC08AC9A134AB97),
+    UINT64_C(0x00019636B08941BC), UINT64_C(0xF419580CA62C8E6E),
+    UINT64_C(0xEB1471CAD77CA9C3), UINT64_C(0x21558EE232975D6F),
+    UINT64_C(0x18FC34188BF6F2A8), UINT64_C(0xEECECB58EAC060DE),
+    UINT64_C(0x3F5620445C8258C9), UINT64_C(0xF04284AED805FA53)
+};
+
+int osrep_frag_params_zpaq(osrep_frag_params *params, unsigned fragment,
+                           uint32_t block_size) {
+  uint64_t max64, min64;
+  if (params == NULL || fragment > 22) return OSREP_FRAG_EINVAL;
+  if (block_size == 0) block_size = ZPAQ_DEFAULT_BLOCK;
+  if (block_size <= 12) return OSREP_FRAG_EINVAL;
+  max64 = (uint64_t)8128u << fragment;
+  if (fragment > 19 || max64 > (uint64_t)block_size - 12)
+    max64 = (uint64_t)block_size - 12;
+  min64 = (uint64_t)64u << fragment;
+  if (min64 > max64) min64 = max64;
+  params->mode = OSREP_FRAG_MODE_ZPAQ;
+  params->min = (uint32_t)min64;
+  params->max = (uint32_t)max64;
+  params->threshold = (fragment <= 22) ? (UINT32_C(1) << (22 - fragment)) : 0;
+  params->avg = 0;
+  params->norm = 0;
+  params->t_small = params->t_large = 0;
+  params->flags = 0;
+  return OSREP_FRAG_OK;
+}
+
+int osrep_frag_params_gear(osrep_frag_params *params, unsigned fragment,
+                           uint32_t block_size, unsigned min_shift,
+                           unsigned level) {
+  uint64_t avg, t;
+  if (min_shift < 1 || min_shift > 4 || level > 3 || fragment > 21)
+    return OSREP_FRAG_EINVAL;
+  if (osrep_frag_params_zpaq(params, fragment, block_size) != OSREP_FRAG_OK)
+    return OSREP_FRAG_EINVAL;
+  /* zpaq's max (8128 << N, clamped to the block) stays; the average is
+     2^N KiB, at most half of max when the block clamps it. */
+  avg = UINT64_C(1024) << fragment;
+  if (avg > params->max / 2) avg = params->max / 2;
+  if (avg < 1024) return OSREP_FRAG_EINVAL;
+  t = ((UINT64_MAX / avg) >> 16) * gear_k[min_shift - 1][level];
+  params->mode = OSREP_FRAG_MODE_GEAR;
+  params->min = (uint32_t)(avg >> min_shift);
+  params->avg = (uint32_t)avg;
+  params->norm = (uint32_t)avg;
+  params->t_small = t >> level;
+  params->t_large = t << level;
+  params->threshold = 0;
+  return OSREP_FRAG_OK;
+}
+
+int osrep_frag_params_osrep(osrep_frag_params *params, unsigned fragment,
+                            uint32_t block_size) {
+  int rc = osrep_frag_params_gear(params, fragment, block_size,
+                                  OSREP_GEAR_MIN_SHIFT, OSREP_GEAR_LEVEL);
+  if (rc == OSREP_FRAG_OK) params->flags = OSREP_GEAR_FLAGS;
+  return rc;
+}
+
+int osrep_frag_params_fnv(osrep_frag_params *params, unsigned fragment,
+                          uint32_t block_size) {
+  uint64_t avg;
+  if (osrep_frag_params_zpaq(params, fragment, block_size) != OSREP_FRAG_OK)
+    return OSREP_FRAG_EINVAL;
+  /* Default N=6 maps to the 8 KiB OSREP average that benchmarked well for
+     -m5; smaller N gives smaller fragments (N=3 -> 1 KiB). */
+  avg = UINT64_C(65536);
+  if (fragment > 9)
+    avg <<= (fragment - 9);
+  else if (fragment < 9)
+    avg >>= (9 - fragment);
+  if (avg < 1024) avg = 1024;
+  if (avg > (UINT64_C(1) << 20)) avg = UINT64_C(1) << 20;
+  params->mode = OSREP_FRAG_MODE_OSREP;
+  params->avg = (uint32_t)avg;
+  params->norm = 0;
+  params->t_small = params->t_large = 0;
+  return OSREP_FRAG_OK;
+}
+
+void osrep_frag_state_reset(osrep_frag_state *state,
+                            const osrep_frag_params *params) {
+  /* ring[] is read only where this fragment has written it */
+  memset(state, 0, offsetof(osrep_frag_state, ring));
+  state->mode = params->mode;
+  state->flags = (params->mode == OSREP_FRAG_MODE_GEAR) ? params->flags : 0;
+  state->min = params->min;
+  state->max = params->max;
+  state->threshold = params->threshold;
+  state->avg = params->avg;
+  state->norm = params->norm;
+  state->t_small = params->t_small;
+  state->t_large = params->t_large;
+  if (params->mode == OSREP_FRAG_MODE_OSREP) {
+    uint64_t p = 1;
+    int i;
+    for (i = 0; i < OSREP_WINDOW; i++) p *= FNV_PRIME;
+    state->pow = p;
+  }
+}
+
+/* Format-aware cuts. The ring holds the fragment's bytes at position
+   p & 511; every rule reads only positions this fragment has written. */
+#define ZIP_LOCAL UINT32_C(0x504B0304)
+#define ZIP_CENTRAL UINT32_C(0x504B0102)
+/* A signature cut needs this much in the fragment first: without it an
+   archive of tiny members (or data full of "PK\3\4") gives fragments of a
+   few bytes, each paying ~28 bytes of zpaq index. */
+#define ZIP_SIG_MIN 512u
+
+/* A ustar header ends at the last byte pushed: the magic at offset 257 and
+   a checksum that matches (unsigned sum, the field read as spaces). */
+static int tar_header_ends(const osrep_frag_state *s) {
+  const uint8_t *r = s->ring;
+  uint32_t j = s->size - 512u, k, sum = 0, want = 0;
+  uint8_t m5;
+  if (r[(j + 257u) & 511u] != 'u' || r[(j + 258u) & 511u] != 's' ||
+      r[(j + 259u) & 511u] != 't' || r[(j + 260u) & 511u] != 'a' ||
+      r[(j + 261u) & 511u] != 'r')
+    return 0;
+  m5 = r[(j + 262u) & 511u];
+  if (m5 != 0 && m5 != ' ') return 0;
+  for (k = 0; k < 8; k++) {
+    uint8_t d = r[(j + 148u + k) & 511u];
+    if (d >= '0' && d <= '7')
+      want = want * 8u + (uint32_t)(d - '0');
+    else if (d != ' ' && d != 0)
+      return 0;
+  }
+  for (k = 0; k < 512; k++)
+    sum += (k >= 148 && k < 156) ? (uint32_t)' ' : r[(j + k) & 511u];
+  return sum == want;
+}
+
+/* zip compression methods: stored, deflate, deflate64, bzip2, lzma, zstd,
+   mp3, xz, AES */
+static int zip_method(uint8_t m) {
+  return m == 0 || m == 8 || m == 9 || m == 12 || m == 14 || m == 93 ||
+         m == 94 || m == 95 || m == 98 || m == 99;
+}
+
+static int format_cut(osrep_frag_state *s, uint8_t c) {
+  const uint32_t f = s->flags;
+  s->ring[(s->size - 1u) & 511u] = c;
+  s->last4 = (s->last4 << 8) | c;
+  if (f & OSREP_FRAG_F_ZIP_SIG) {
+    const uint8_t *r = s->ring;
+    /* after a local header signature: the fragment before ends with the
+       same four bytes whatever member comes next */
+    if (s->last4 == ZIP_LOCAL && s->size >= ZIP_SIG_MIN) return 1;
+    /* the same after the first central directory signature: not when this
+       fragment began with the rest of a central directory entry */
+    if (s->size == 42)
+      s->zcd = r[3] == 0 && r[2] <= 63 && r[7] == 0 && zip_method(r[6]);
+    if (s->last4 == ZIP_CENTRAL && s->size >= ZIP_SIG_MIN && !s->zcd)
+      return 1;
+    if (f & OSREP_FRAG_F_ZIP_AFTER) {
+      /* this fragment may be the rest of a local header (it began just
+         after a signature): the fixed part checks, then name and extra */
+      if (s->size == 26) {
+        uint32_t n = (uint32_t)r[22] | ((uint32_t)r[23] << 8);
+        uint32_t m = (uint32_t)r[24] | ((uint32_t)r[25] << 8);
+        if (r[1] == 0 && r[0] <= 63 && r[5] == 0 && zip_method(r[4]) &&
+            n != 0 && n <= 4096 && m <= 4096)
+          s->zend = 26u + n + m;
+      }
+      if (s->zend != 0 && s->size == s->zend) return 1;
+    }
+  }
+  /* the last byte of a ustar/gnu/pax header is padding (0) */
+  if ((f & OSREP_FRAG_F_TAR_AFTER) && c == 0 && s->size >= 512 &&
+      tar_header_ends(s))
+    return 1;
+  return 0;
+}
+
+int osrep_frag_state_push(osrep_frag_state *state, uint8_t c) {
+  uint8_t pred = state->o1[state->c1];
+  state->hits += (c == pred);
+  state->o1[state->c1] = c;
+  state->c1 = c;
+  ++state->size;
+
+  if (state->mode == OSREP_FRAG_MODE_GEAR) {
+    if (state->flags != 0 && format_cut(state, c)) return 1;
+    /* The hash only sees the last 64 bytes, so starting it 64 bytes before
+       min gives the same values as starting it at the cut. */
+    if (state->size + GEAR_WINDOW > state->min) {
+      state->h64 = (state->h64 << 1) + osrep_gear[c];
+      if (state->size >= state->min &&
+          state->h64 < (state->size < state->norm ? state->t_small
+                                                  : state->t_large))
+        return 1;
+    }
+    return state->size >= state->max;
+  }
+
+  if (state->mode == OSREP_FRAG_MODE_OSREP) {
+    state->h64 = state->h64 * FNV_PRIME + c;
+    if (state->winlen >= OSREP_WINDOW)
+      state->h64 -= (uint64_t)state->win[state->winpos] * state->pow;
+    state->win[state->winpos] = c;
+    state->winpos = (state->winpos + 1) % OSREP_WINDOW;
+    if (state->winlen < OSREP_WINDOW) ++state->winlen;
+    if (state->size >= state->min && state->avg != 0 &&
+        (state->h64 < UINT64_MAX / state->avg || state->size >= state->max))
+      return 1;
+    return 0;
+  }
+
+  state->h = (state->h + (uint32_t)c + 1u) *
+             ((c == pred) ? HASH_MULT_HIT : HASH_MULT_MISS);
+  if (state->threshold != 0 && state->h < state->threshold &&
+      state->size >= state->min)
+    return 1;
+  return 0;
+}
+
+#define O1_STEP(c)                 \
+  do {                             \
+    uint8_t pred_ = o1[c1];        \
+    hits += ((c) == pred_);        \
+    o1[c1] = (c);                  \
+    c1 = (c);                      \
+  } while (0)
+
+size_t osrep_frag_state_scan(osrep_frag_state *state, const uint8_t *buf,
+                             size_t len, int *cut) {
+  size_t i = 0, end;
+  uint32_t size, min, hstart, norm, max;
+  uint64_t h, t;
+  uint32_t hits;
+  uint8_t c1, *o1;
+
+  *cut = 0;
+  if (state->mode != OSREP_FRAG_MODE_GEAR || state->flags != 0) {
+    while (i < len) {
+      int r = osrep_frag_state_push(state, buf[i++]);
+      if (r || state->size >= state->max) {
+        *cut = 1;
+        break;
+      }
+    }
+    return i;
+  }
+  size = state->size;
+  min = state->min;
+  max = state->max;
+  norm = state->norm;
+  hstart = min > GEAR_WINDOW ? min - GEAR_WINDOW : 0;
+  h = state->h64;
+  hits = state->hits;
+  c1 = state->c1;
+  o1 = state->o1;
+  /* sizes up to hstart: order-1 only */
+  if (size < hstart) {
+    end = hstart - size;
+    if (end > len) end = len;
+    for (; i < end; i++) O1_STEP(buf[i]);
+    size += (uint32_t)end;
+  }
+  /* bytes that end below min: hash, no cut */
+  if (i < len && size + 1 < min) {
+    end = i + (min - 1 - size);
+    if (end > len) end = len;
+    for (; i < end; i++) {
+      uint8_t c = buf[i];
+      O1_STEP(c);
+      h = (h << 1) + osrep_gear[c];
+    }
+    size = state->size + (uint32_t)i;
+  }
+  /* bytes that end at min or later: hash and cut, t_small while the size
+     after the byte is below norm, t_large from norm to max */
+  while (i < len && size < max) {
+    if (size + 1 < norm) {
+      t = state->t_small;
+      end = i + (norm - 1 - size);
+    } else {
+      t = state->t_large;
+      end = i + (max - size);
+    }
+    if (end > len) end = len;
+    for (; i < end; i++) {
+      uint8_t c = buf[i];
+      O1_STEP(c);
+      h = (h << 1) + osrep_gear[c];
+      if (h < t) {
+        ++i;
+        *cut = 1;
+        break;
+      }
+    }
+    size = state->size + (uint32_t)i;
+    if (*cut) break;
+  }
+  if (!*cut && i > 0 && size >= max) *cut = 1;
+  state->size = size;
+  state->h64 = h;
+  state->hits = hits;
+  state->c1 = c1;
+  return i;
+}
+
+static int append_fragment(osrep_frag **arr, size_t *cap, size_t *count,
+                           const uint8_t *buf, size_t start, size_t len,
+                           uint32_t hits, const uint8_t o1[256]) {
+  osrep_frag *f;
+  if (*count == *cap) {
+    size_t newcap = *cap * 2;
+    osrep_frag *grown;
+    if (newcap <= *cap || newcap > SIZE_MAX / sizeof(**arr))
+      return OSREP_FRAG_ENOMEM;
+    grown = (osrep_frag *)realloc(*arr, newcap * sizeof(**arr));
+    if (grown == NULL) return OSREP_FRAG_ENOMEM;
+    *arr = grown;
+    *cap = newcap;
+  }
+  f = &(*arr)[*count];
+  f->off = (uint64_t)start;
+  f->size = (uint32_t)len;
+  f->hits = hits;
+  memcpy(f->o1, o1, 256);
+  osrep_sha1(buf + start, len, f->sha1);
+  ++*count;
+  return OSREP_FRAG_OK;
+}
+
+int osrep_fragment_buffer(const uint8_t *buf, size_t len,
+                          const osrep_frag_params *params, osrep_frag **out,
+                          size_t *out_n) {
+  osrep_frag *arr;
+  osrep_frag_state st;
+  size_t cap, count = 0, start = 0, i;
+  int rc;
+
+  if (out == NULL || out_n == NULL || params == NULL) return OSREP_FRAG_EINVAL;
+  *out = NULL;
+  *out_n = 0;
+  if (buf == NULL && len != 0) return OSREP_FRAG_EINVAL;
+  if (params->mode != OSREP_FRAG_MODE_ZPAQ &&
+      params->mode != OSREP_FRAG_MODE_OSREP &&
+      params->mode != OSREP_FRAG_MODE_GEAR)
+    return OSREP_FRAG_ENOTSUP;
+  if (params->min == 0 || params->max == 0) return OSREP_FRAG_EINVAL;
+  if (params->mode != OSREP_FRAG_MODE_ZPAQ && params->avg == 0)
+    return OSREP_FRAG_EINVAL;
+  if ((params->flags & ~OSREP_FRAG_F_FORMAT) != 0 ||
+      (params->flags != 0 && params->mode != OSREP_FRAG_MODE_GEAR))
+    return OSREP_FRAG_EINVAL;
+  if (len == 0) return OSREP_FRAG_OK;
+
+  cap = len / (size_t)params->min + 2;
+  if (cap > 1024) cap = 1024;
+  if (cap < 8) cap = 8;
+  if (cap > SIZE_MAX / sizeof(*arr)) return OSREP_FRAG_ENOMEM;
+  arr = (osrep_frag *)malloc(cap * sizeof(*arr));
+  if (arr == NULL) return OSREP_FRAG_ENOMEM;
+
+  osrep_frag_state_reset(&st, params);
+  for (i = 0; i < len; i++) {
+    int cut = osrep_frag_state_push(&st, buf[i]);
+    if (cut || st.size >= params->max) {
+      rc = append_fragment(&arr, &cap, &count, buf, start, st.size, st.hits,
+                           st.o1);
+      if (rc != OSREP_FRAG_OK) {
+        free(arr);
+        return rc;
+      }
+      start = i + 1;
+      osrep_frag_state_reset(&st, params);
+    }
+  }
+  if (st.size != 0) {
+    rc = append_fragment(&arr, &cap, &count, buf, start, st.size, st.hits,
+                         st.o1);
+    if (rc != OSREP_FRAG_OK) {
+      free(arr);
+      return rc;
+    }
+  }
+
+  *out = arr;
+  *out_n = count;
+  return OSREP_FRAG_OK;
+}
+
+void osrep_frag_free(osrep_frag *p) { free(p); }
diff --git a/compressors/osrep/osrep_fragment.h b/compressors/osrep/osrep_fragment.h
new file mode 100644
index 0000000..db05257
--- /dev/null
+++ b/compressors/osrep/osrep_fragment.h
@@ -0,0 +1,154 @@
+#ifndef OSREP_FRAGMENT_H
+#define OSREP_FRAGMENT_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Mode 0 reproduces zpaq-std's order-1 fragmenter byte for byte. Mode 1 is
+   OSREP's first content-defined fragmenter: a 48-byte FNV rolling hash that
+   cuts at the target average, between the same minimum and maximum (the -m1
+   CDC). Mode 2 is the one -osrep uses: a 64-byte gear hash with cut-point
+   skipping; it can also do FastCDC normalized chunking (a stricter cut
+   condition before the normal size, a looser one after), which -osrep does
+   not use (docs/experiments/frag-normalized.md). */
+#define OSREP_FRAG_MODE_ZPAQ 0u
+#define OSREP_FRAG_MODE_OSREP 1u
+#define OSREP_FRAG_MODE_GEAR 2u
+
+#define OSREP_FRAG_OK 0
+#define OSREP_FRAG_EINVAL 1
+#define OSREP_FRAG_ENOMEM 2
+#define OSREP_FRAG_ENOTSUP 3
+
+/* Format-aware cuts (gear mode only): forced cuts at archive structure
+   boundaries, decided only from the bytes of the current fragment, so the
+   state still starts fresh at every cut and add2_scan's resync holds. They
+   ignore the minimum and never move a cut back (no byte is given back).
+   TAR_AFTER: after a ustar/gnu/pax header with a valid checksum.
+   ZIP_SIG: after a zip local header signature ("PK\3\4") and after the
+     first central directory signature ("PK\1\2" ending a fragment that did
+     not begin inside the central directory).
+   ZIP_AFTER (with ZIP_SIG): also after the rest of a local header (26 bytes
+     plus name and extra), so a member's data starts its own fragment.
+   The values are those of docs/experiments/frag-formataware.md, where the
+   rules that give bytes back (TAR_BEFORE 1, ZIP_BEFORE 4) and the newline
+   rule (TEXT 16) were measured and left out. osrep_frag_params_osrep() sets
+   OSREP_FRAG_F_FORMAT. */
+#define OSREP_FRAG_F_TAR_AFTER 2u
+#define OSREP_FRAG_F_ZIP_AFTER 8u
+#define OSREP_FRAG_F_ZIP_SIG 32u
+#define OSREP_FRAG_F_FORMAT \
+  (OSREP_FRAG_F_TAR_AFTER | OSREP_FRAG_F_ZIP_AFTER | OSREP_FRAG_F_ZIP_SIG)
+
+/* What zpaq-std needs for its fragment table and data-type analysis. */
+typedef struct {
+  uint64_t off;      /* byte offset in the input buffer */
+  uint32_t size;     /* fragment length */
+  uint8_t sha1[20];  /* SHA-1 of the fragment */
+  uint32_t hits;     /* order-1 prediction hits inside the fragment */
+  uint8_t o1[256];   /* order-1 table at the end of the fragment */
+} osrep_frag;
+
+typedef struct {
+  uint32_t mode;       /* OSREP_FRAG_MODE_* */
+  uint32_t min;        /* minimum fragment size */
+  uint32_t max;        /* maximum fragment size */
+  uint32_t threshold;  /* zpaq mode: cut when h < threshold */
+  uint32_t avg;        /* OSREP and gear modes: target average size */
+  /* Gear mode: cut when h < t_small at sizes [min, norm), when h < t_large
+     at sizes [norm, max), and at max. osrep_frag_params_osrep() fills them. */
+  uint32_t norm;
+  uint64_t t_small;
+  uint64_t t_large;
+  uint32_t flags;      /* gear mode: OSREP_FRAG_F_* (0 = plain CDC) */
+} osrep_frag_params;
+
+/* Incremental state for callers that read a file in blocks. Reset it at the
+   start of every file and after every cut; push one byte and it returns 1
+   when the fragment must end after that byte. In zpaq mode the max-size cut
+   stays with the caller; the OSREP and gear modes also return 1 at max. The
+   cuts depend only on the bytes since the last cut. */
+typedef struct {
+  uint32_t mode;
+  uint32_t h;
+  uint32_t hits;
+  uint32_t min;
+  uint32_t max;
+  uint32_t threshold;
+  uint32_t avg;
+  uint32_t size;
+  uint8_t c1;
+  uint8_t o1[256];
+  uint64_t h64;
+  uint64_t pow;
+  uint8_t win[48];
+  uint32_t winpos;
+  uint32_t winlen;
+  uint32_t norm;
+  uint64_t t_small;
+  uint64_t t_large;
+  uint32_t flags;     /* OSREP_FRAG_F_* */
+  uint32_t last4;     /* the last four bytes, big-endian */
+  uint32_t zend;      /* ZIP_AFTER: end of the local header at the start */
+  uint32_t zcd;       /* ZIP_SIG: this fragment began in the central dir */
+  uint8_t ring[512];  /* format rules: the last 512 bytes; not cleared */
+} osrep_frag_state;
+
+void osrep_frag_state_reset(osrep_frag_state *state,
+                            const osrep_frag_params *params);
+int osrep_frag_state_push(osrep_frag_state *state, uint8_t c);
+/* The same as pushing buf[0..len) one byte at a time, but stops after the
+   byte that ends the fragment (content or format cut, or max in the OSREP
+   and gear modes). Returns the number of bytes consumed and sets *cut to 1
+   when the fragment ended there. The fast path for the gear mode without
+   flags; with flags it pushes byte by byte. */
+size_t osrep_frag_state_scan(osrep_frag_state *state, const uint8_t *buf,
+                             size_t len, int *cut);
+
+/* Fill params with zpaq-std's -fragment N mapping. block_size is zpaq's
