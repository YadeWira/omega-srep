 Makefile                           |  11 +-
 compressors/osrep/LICENSE          |  21 ++
 compressors/osrep/osrep_fragment.c | 566 +++++++++++++++++++++++++++++
 compressors/osrep/osrep_fragment.h | 154 ++++++++
 compressors/osrep/osrep_sha1.c     |  89 +++++
 zpaq-std.cpp                       | 149 +++++++-
 6 files changed, 986 insertions(+), 4 deletions(-)
 create mode 100644 compressors/osrep/LICENSE
 create mode 100644 compressors/osrep/osrep_fragment.c
 create mode 100644 compressors/osrep/osrep_fragment.h
 create mode 100644 compressors/osrep/osrep_sha1.c

diff --git a/Makefile b/Makefile
index c35c600..461eb3b 100644
--- a/Makefile
+++ b/Makefile
@@ -91,6 +91,8 @@ SOURCE  := zpaq-std.cpp
 LZ5SRC  := compressors/lz5/lz5.c compressors/lz5/lz5hc.c
 LZ4SRC  := compressors/lz4/lz4.c compressors/lz4/lz4hc.c
 LZ6SRC  := compressors/lz6/lz6.c compressors/lz6/lz6hc.c
+# OSREP's fragmenter (-osrep, MIT): plain C99, linked into the program
+OSREPSRC := compressors/osrep/osrep_fragment.c compressors/osrep/osrep_sha1.c
 # LZMA SDK (-ma:lzma): single-threaded match finder, see compressors/lzmasdk/LEEME.md
 LZMASRC := compressors/lzmasdk/LzmaLib.c compressors/lzmasdk/LzmaEnc.c compressors/lzmasdk/LzmaDec.c compressors/lzmasdk/LzFind.c compressors/lzmasdk/LzFindOpt.c compressors/lzmasdk/Alloc.c compressors/lzmasdk/CpuArch.c
 ZSTDSRC := compressors/zstd/zstd.c
@@ -197,6 +199,7 @@ endif
 # not deterministic. Measured cost: none (slightly faster).
 LZ5INC  := -Icompressors/lz5 -DLZ5_RESET_MEM
 LZ6INC  := -Icompressors/lz6
+OSREPINC := -Icompressors/osrep
 LZMAINC := -Icompressors/lzmasdk -DZ7_ST
 LIZINC  := -Icompressors/lizard -Icompressors/lizard/entropy -DLIZARD_RESET_MEM
 BZIP2INC := -Icompressors/bzip2
@@ -374,6 +377,7 @@ BZ2NGBUNDLE := compressors/bz2ng/bz2ng-bundle.o
 LZ5OBJ := $(LZ5SRC:.c=.o)
 LZ4OBJ := $(LZ4SRC:.c=.o)
 LZ6OBJ := $(LZ6SRC:.c=.o)
+OSREPOBJ := $(OSREPSRC:.c=.o)
 LZMAOBJ := $(LZMASRC:.c=.o)
 LIZOBJ := $(LIZSRC:.c=.o)
 BZIP2OBJ := $(BZIP2SRC:.c=.o)
@@ -482,9 +486,9 @@ ifdef PLUGINS
 endif
 # Everything the program links. make plugins leaves out CORE_DROP: the adapters
 # and the libraries that went into plugins.
-LINKOBJS = $(DIVSUFOBJ) $(SOURCE) $(FL2OBJ) $(UFL2BUNDLE) $(BZ2NGBUNDLE) $(PLUGOBJ) $(LZ4OBJ) $(LZ5OBJ) $(LZ6OBJ) $(LZMAOBJ) $(LIZOBJ) $(BZIP2OBJ) $(BZIP3OBJ) $(BROTLIOBJ) $(SNAPPYOBJ) $(LIBDEFLATEOBJ) $(LZLIBOBJ) $(HSOBJ) $(LZFSEOBJ) $(BSCOBJ) $(KANZIOBJ) $(LZHAMOBJ) $(PPMDOBJ) $(ZXCOBJ) $(WINRES)
+LINKOBJS = $(DIVSUFOBJ) $(SOURCE) $(FL2OBJ) $(UFL2BUNDLE) $(BZ2NGBUNDLE) $(PLUGOBJ) $(LZ4OBJ) $(LZ5OBJ) $(LZ6OBJ) $(OSREPOBJ) $(LZMAOBJ) $(LIZOBJ) $(BZIP2OBJ) $(BZIP3OBJ) $(BROTLIOBJ) $(SNAPPYOBJ) $(LIBDEFLATEOBJ) $(LZLIBOBJ) $(HSOBJ) $(LZFSEOBJ) $(BSCOBJ) $(KANZIOBJ) $(LZHAMOBJ) $(PPMDOBJ) $(ZXCOBJ) $(WINRES)
 $(PROG): $(filter-out $(CORE_DROP),$(LINKOBJS))
-	$(CXX) $(ZPAQ_CPPFLAGS) $(ZPAQ_CXXFLAGS) $(ZSTDINC) $(HSINC) $(LZFSEINC) $(BSCINC) $(LZHAMINC) $(BROTLIINC) $(PPMDINC) $(LDFLAGS) $(filter-out $(CORE_DROP),$(LINKOBJS)) $(ZPAQ_WIN_LIBS) $(LDLIBS) -o $@
+	$(CXX) $(ZPAQ_CPPFLAGS) $(ZPAQ_CXXFLAGS) $(ZSTDINC) $(HSINC) $(LZFSEINC) $(BSCINC) $(LZHAMINC) $(BROTLIINC) $(PPMDINC) $(OSREPINC) $(LDFLAGS) $(filter-out $(CORE_DROP),$(LINKOBJS)) $(ZPAQ_WIN_LIBS) $(LDLIBS) -o $@
 	$(ZPAQ_POSTLINK)
 
 # RT_MANIFEST resource (Windows/MinGW only) for visual-styled common controls.
@@ -628,6 +632,9 @@ compressors/lz5/%.o: compressors/lz5/%.c
 compressors/lz6/%.o: compressors/lz6/%.c
 	$(CC) $(ZPAQ_CFLAGS) $(LZ6INC) -c $< -o $@
 
+compressors/osrep/%.o: compressors/osrep/%.c
+	$(CC) $(ZPAQ_CFLAGS) -std=c99 $(OSREPINC) -c $< -o $@
+
 compressors/lzmasdk/%.o: compressors/lzmasdk/%.c
 	$(CC) $(ZPAQ_CFLAGS) $(LZMAINC) -c $< -o $@
 
