# Build output. Anchored: an unanchored `bin/` would also swallow source
# directories named bin/. The Pascal builds into pascal/bin/; the archived
# oracles build inside their extracted tarball, not here.
pascal/bin/
# Pre-reorg build output (up to 2.2.1), so stale dirs in old checkouts stay ignored.
/bin/
/target/
__pycache__/
build/
build-cmake/
pgo-data/
pgo-data-win/
tests/corpus/
tests/fuzz-corpus/
tests/fuzz-corpus-decode-streaming/
tests/fuzz-corpus-encode-split/
tests/fuzz-artifacts/
*.tmp
osrep-data.tmp
osrep-virtual-memory.tmp
data.tar
doubled.*
fa011.zip
srep392.zip
SREP_Technical_Documentation.zip

# Session state, not project files: the agent tool's own settings, and the
# notes that get exchanged with other sessions working alongside this one.
.commandcode/
message-from-*.md
credenciales.md
handoff.md

# build artifacts from manual unit compiles
pascal/src/*.o
pascal/src/*.ppu
